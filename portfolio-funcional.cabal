cabal-version:      3.0
name:               portfolio-funcional
version:            0.1.0.0
build-type:         Simple

executable portfolio-funcional
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:
      Combinations
      CsvLoader
      DowJones
      ParallelEval
      Report
      Simulation
      Statistics
      Types
      Weights
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded -rtsopts
  build-depends:
      base >=4.18 && <5
    , deepseq
    , directory
    , filepath
    , time

